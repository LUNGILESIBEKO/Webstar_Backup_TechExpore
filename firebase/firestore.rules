rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A student must have verified their email before the app can read their data.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Each student can read/write ONLY their own profile document.
    match /users/{uid} {
      // Sign-up creates the profile right after the account exists, i.e. before
      // the student has had a chance to click the verification link.
      allow create: if signedIn() && request.auth.uid == uid;
      allow read, update, delete: if verified() && request.auth.uid == uid;
    }

    // Shared reference content: any VERIFIED signed-in user can read, nobody can edit from the app.
    match /{coll}/{docId} {
      allow read: if verified()
        && coll in ['skills','certs','jobs','roadmap_steps','quiz_questions','career_tracks','job_prep_tips','institutions','mentors'];
      allow write: if false;
    }

    // Temporary connection test (used by checkFirestore.js)
    match /_connection_test/{docId} {
      allow read, write: if verified();
    }
  }
}
